# Copy to .env (repo root) for local development.

# anthropic | openai | none   (none = retrieval-only: cited passages, no generated text)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# fastembed (local, default) | openai | hash (offline, lexical - tests only)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
# Only needed when EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=


# RETRIEVAL_TOP_K=6
# MIN_RELEVANCE=0.35   # UNCALIBRATED default: run `aeris eval --sweep` after ingesting
# VECTOR_STORE_DIR=./backend/vector_store

# CORS_ORIGINS=http://localhost:5173

# Reserved for Phase 2 (simulation + checklist data)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aeris
