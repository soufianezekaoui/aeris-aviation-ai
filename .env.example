# anthropic | openai | none   (none = retrieval-only: cited passages, no generated text)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# =======Embedding configuration (for retrieval)========================================
# fastembed (local, default) | openai | hash (offline, lexical - tests only)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=                          # Only needed when EMBEDDING_PROVIDER=openai

# ======= Retrieval configuration (for retrieval)========================================
# RETRIEVAL_TOP_K=6
MIN_RELEVANCE=0.55   # UNCALIBRATED default: run `aeris eval --sweep` after ingesting
# VECTOR_STORE_DIR=./backend/vector_store

# ======= API configuration (for retrieval)==============================================
# CORS_ORIGINS=http://localhost:5173

# ======= Database configuration (for simulation + checklist data)========================
# Use SQLite for local development, PostgreSQL for production. 
# DATABASE_URL=postgresql://aeris:aeris@localhost:5432/aeris
DATABASE_URL=
